# RPC endpoint for Push Chain Donut Testnet
PUSH_DONUT_RPC_URL=

# Target network name; selects deployments/<NETWORK>.json
NETWORK=anvil

# Deployment input: the UniversalGatewayPC address on the target chain.
# Becomes immutable in ACPActionPolicy at construction.
UNIVERSAL_GATEWAY_PC=

# Deployer key. Never commit a real key.
PRIVATE_KEY=
