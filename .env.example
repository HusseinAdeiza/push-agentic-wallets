# ── Network ──────────────────────────────────────────────────────────────
# RPC endpoint for Push Chain Donut Testnet. Also gates the P-03 fork test:
# when PUSH_TESTNET_RPC is empty, test_V11_ed25519AgainstRealPrecompile skips.
PUSH_DONUT_RPC_URL=
PUSH_TESTNET_RPC=

# Selects the deployment record: deployments/<chainId>.json
# (SmartSession deployment spec, S-05). Local runs use anvil's 31337.
CHAIN_ID=31337

# ── Deployment inputs (become immutables at construction) ────────────────
# UniversalGatewayPC on the target chain — URP and the wallet implementation.
UNIVERSAL_GATEWAY_PC=
# Universal Executor Module on the target chain — URP's creditRevert caller.
# Confirm against a live deployment before any non-local deploy (register D2).
UNIVERSAL_EXECUTOR_MODULE=

# ── Deploy-time sanity check (optional; skipped when unset or codeless) ──
# push-chain-core's UEAFactory. The deploy script asks it what Push calls itself and refuses to
# deploy if core and `block.chainid` disagree — the mandate mode is derived from that identity, so a
# disagreement would make every native mandate derive UNIVERSAL and fail at grant.
# Donut: 0x00000000000000000000000000000000000000eA
# Left unset for local anvil runs, which have no core deployment.
UEA_FACTORY=

# ── Deployer ─────────────────────────────────────────────────────────────
# Deployer key. Never commit a real key. Never paste one into a chat.
PRIVATE_KEY=
