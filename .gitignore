out/
cache/
broadcast/
.env
lcov.info
node_modules/

# Local deploy artifacts. Real deployments are recorded deliberately, not by
# whatever anvil run happened last.
deployments/*.json
!deployments/.gitkeep

# macOS Finder metadata.
.DS_Store

# Per-developer Claude Code config. Hooks here point at absolute paths on one
# machine, so committing it breaks every other clone.
.claude/

# Staging area for the v1/v2 files removed at the start of v3. Delete the folder.
_to_delete/

# Docs
docs-internal/

demo/
# Demo Ledger. Per-run state (addresses, permission id, nonce lane position) written by
# the demo scripts. Regenerated by a rehearsal; never a record of anything permanent.
demo/state/
demo/ref_contracts/
demo-native/state/

# The native demo is frozen against the deployed v1 contracts and does not compile against the renamed
# src/ (nomenclature change). It is already tracked, so this entry only affects new files.
demo-native/
