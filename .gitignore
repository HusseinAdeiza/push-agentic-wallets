out/
cache/
broadcast/
.env
lcov.info
node_modules/

# forge doc output. Hand-written docs live in docs/ and ARE tracked.
docs/book/
docs-internal

# Local deploy artifacts. Real deployments are recorded deliberately, not by
# whatever anvil run happened last.
deployments/*.json
!deployments/.gitkeep
DEVIATIONS.md

# macOS Finder metadata.
.DS_Store

# Per-developer Claude Code config. Hooks here point at absolute paths on one
# machine, so committing it breaks every other clone.
.claude/

# Throwaway archives created to hand the tree to a reviewer.
.review_bundle.tgz


  # Generated knowledge graph. Regenerate with `graphify update .` — the manifest
  # and cache key off absolute local paths, so they are not portable across clones.
graphify-out/
